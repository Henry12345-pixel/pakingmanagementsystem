<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ucc.parkingsystem.controller.VehicleExitController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="header-bar, staff">
            <Button text="← Back" onAction="#onBackClick" styleClass="button-ghost"/>
            <Label text="🚙 Record Vehicle Exit" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16.0" style="-fx-padding: 24;">

            <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="form-panel">
                <VBox spacing="4.0">
                    <Label text="SEARCH PLATE" styleClass="field-label"/>
                    <TextField fx:id="searchField" promptText="Type part of a plate number"
                               prefWidth="250.0"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Record Exit for Selected" onAction="#onRecordExitClick"
                        styleClass="button-primary"/>
            </HBox>

            <Label fx:id="messageLabel" wrapText="true" styleClass="message-error"/>

            <TableView fx:id="parkedTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="plateColumn" text="Plate No."/>
                    <TableColumn fx:id="typeColumn" text="Vehicle Type"/>
                    <TableColumn fx:id="slotColumn" text="Slot"/>
                    <TableColumn fx:id="entryColumn" text="Entry Time"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>