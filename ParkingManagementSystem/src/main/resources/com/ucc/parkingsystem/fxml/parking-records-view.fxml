<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ucc.parkingsystem.controller.ParkingRecordsController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="header-bar">
            <Button text="Back" onAction="#onBackClick" styleClass="button-ghost"/>
            <Label text="Parking records" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="32.0" styleClass="page">

            <HBox spacing="14.0" alignment="BOTTOM_LEFT" styleClass="form-panel">
                <VBox spacing="8.0" HBox.hgrow="SOMETIMES">
                    <Label text="Search plate number" styleClass="field-label"/>
                    <TextField fx:id="searchField" promptText="Type part of a plate number"
                               prefWidth="300.0"/>
                </VBox>
                <VBox spacing="8.0">
                    <Label text="Show" styleClass="field-label"/>
                    <ChoiceBox fx:id="filterChoiceBox" prefWidth="170.0"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="countLabel" styleClass="message-muted"/>
                <Button text="Refresh" onAction="#onRefreshClick"/>
            </HBox>

            <Label fx:id="messageLabel" styleClass="message-error" wrapText="true"/>

            <TableView fx:id="recordsTable" VBox.vgrow="ALWAYS" minHeight="260.0">
                <columns>
                    <TableColumn fx:id="plateColumn" text="Plate number"/>
                    <TableColumn fx:id="typeColumn" text="Vehicle type"/>
                    <TableColumn fx:id="slotColumn" text="Slot"/>
                    <TableColumn fx:id="entryColumn" text="Entry time"/>
                    <TableColumn fx:id="exitColumn" text="Exit time"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>
