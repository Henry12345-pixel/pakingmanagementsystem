<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ucc.parkingsystem.controller.ManageStaffController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="header-bar">
            <Button text="← Back" onAction="#onBackClick" styleClass="button-ghost"/>
            <Label text="Manage Staff Accounts" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16.0" style="-fx-padding: 24;">

            <!-- Add new staff form -->
            <VBox spacing="10.0" styleClass="form-panel">
                <Label text="ADD NEW STAFF" styleClass="field-label"/>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <VBox spacing="4.0">
                        <Label text="Full Name" styleClass="field-label"/>
                        <TextField fx:id="fullNameField" prefWidth="140.0"/>
                    </VBox>
                    <VBox spacing="4.0">
                        <Label text="Username" styleClass="field-label"/>
                        <TextField fx:id="usernameField" prefWidth="110.0"/>
                    </VBox>
                    <VBox spacing="4.0">
                        <Label text="Password" styleClass="field-label"/>
                        <StackPane>
                            <PasswordField fx:id="passwordField" prefWidth="110.0"/>
                            <TextField fx:id="passwordTextField" prefWidth="110.0"
                                       visible="false" managed="false"/>
                        </StackPane>
                        <CheckBox fx:id="showPasswordCheck" text="Show" style="-fx-font-size: 10px;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Add Staff" onAction="#onAddClick" styleClass="button-primary"/>
                </HBox>
            </VBox>

            <Label fx:id="messageLabel" styleClass="message-error"/>

            <!-- Existing staff -->
            <TableView fx:id="staffTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Full Name"/>
                    <TableColumn fx:id="usernameColumn" text="Username"/>
                    <TableColumn fx:id="statusColumn" text="Status"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- Actions for the selected staff row -->
            <VBox spacing="10.0" styleClass="form-panel">
                <Label text="SELECTED STAFF ACTIONS" styleClass="field-label"/>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <VBox spacing="4.0">
                        <Label text="New Password" styleClass="field-label"/>
                        <StackPane>
                            <PasswordField fx:id="newPasswordField" prefWidth="140.0"/>
                            <TextField fx:id="newPasswordTextField" prefWidth="140.0"
                                       visible="false" managed="false"/>
                        </StackPane>
                        <CheckBox fx:id="showNewPasswordCheck" text="Show" style="-fx-font-size: 10px;"/>
                    </VBox>
                    <Button text="Reset Password" onAction="#onResetPasswordClick"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Activate" onAction="#onActivateClick"/>
                    <Button text="Deactivate" onAction="#onDeactivateClick" styleClass="button-danger"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>