<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ucc.parkingsystem.controller.ManageStaffController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0"
              style="-fx-padding: 12; -fx-background-color: #2c3e50;">
            <Button text="&lt; Back" onAction="#onBackClick"/>
            <Label text="Manage Staff Accounts"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15.0" style="-fx-padding: 15;">

            <!-- Add new staff form -->
            <HBox spacing="10.0" alignment="CENTER_LEFT"
                  style="-fx-padding: 10; -fx-background-color: #ecf0f1; -fx-background-radius: 6;">
                <Label text="Full Name:"/>
                <TextField fx:id="fullNameField" prefWidth="140.0"/>
                <Label text="Username:"/>
                <TextField fx:id="usernameField" prefWidth="110.0"/>
                <Label text="Password:"/>
                <PasswordField fx:id="passwordField" prefWidth="110.0"/>
                <Button text="Add Staff" onAction="#onAddClick"/>
            </HBox>

            <Label fx:id="messageLabel" style="-fx-text-fill: red;"/>

            <!-- Existing staff -->
            <TableView fx:id="staffTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Full Name"/>
                    <TableColumn fx:id="usernameColumn" text="Username"/>
                    <TableColumn fx:id="statusColumn" text="Status"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- Actions for the selected staff row -->
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="New Password:"/>
                <PasswordField fx:id="newPasswordField" prefWidth="140.0"/>
                <Button text="Reset Password" onAction="#onResetPasswordClick"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Activate" onAction="#onActivateClick"/>
                <Button text="Deactivate" onAction="#onDeactivateClick"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>