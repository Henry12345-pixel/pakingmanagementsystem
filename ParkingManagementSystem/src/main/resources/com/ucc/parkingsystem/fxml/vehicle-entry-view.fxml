<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Opens as a centered pop-up from the Staff Dashboard (see Navigator.openPopup). -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ucc.parkingsystem.controller.VehicleEntryController"
            prefWidth="520.0">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="header-bar, staff">
            <Label text="Record Vehicle Entry" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="✕ Close" onAction="#onCloseClick" styleClass="button-ghost"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="14.0" styleClass="page">

            <VBox spacing="4.0">
                <Label text="VEHICLE TYPE" styleClass="field-label"/>
                <ChoiceBox fx:id="typeChoiceBox" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="4.0">
                <Label text="FLOOR" styleClass="field-label"/>
                <ChoiceBox fx:id="floorChoiceBox" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="4.0">
                <Label text="AVAILABLE SLOT" styleClass="field-label"/>
                <ChoiceBox fx:id="slotChoiceBox" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="4.0">
                <Label text="PLATE NUMBER" styleClass="field-label"/>
                <TextField fx:id="plateField" promptText="ABC 1234" onAction="#onRecordEntryClick"/>
                <Label text="3 letters, then 4 numbers. The space is added automatically."
                       styleClass="message-muted" wrapText="true"/>
            </VBox>

            <Button text="Record Entry" onAction="#onRecordEntryClick"
                    styleClass="button-primary" maxWidth="Infinity"
                    style="-fx-padding: 10;"/>

            <Label fx:id="messageLabel" wrapText="true" styleClass="message-error"
                   minHeight="-Infinity"/>
        </VBox>
    </center>
</BorderPane>
