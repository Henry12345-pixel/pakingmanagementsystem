<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ucc.parkingsystem.controller.StaffDashboardController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="header-bar, staff">
            <Label text="🅿 Staff Dashboard" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="welcomeLabel" styleClass="header-subtitle"/>
            <Button text="Logout" onAction="#onLogoutClick" styleClass="button-ghost"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0" style="-fx-padding: 24;">

            <HBox spacing="16.0">
                <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="stat-card" spacing="4">
                    <Label text="TOTAL SLOTS" styleClass="stat-label"/>
                    <Label fx:id="totalLabel" text="0" styleClass="stat-number"/>
                </VBox>
                <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="stat-card, stat-card-available" spacing="4">
                    <Label text="AVAILABLE" styleClass="stat-label"/>
                    <Label fx:id="availableLabel" text="0" styleClass="stat-number"/>
                </VBox>
                <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="stat-card, stat-card-occupied" spacing="4">
                    <Label text="OCCUPIED" styleClass="stat-label"/>
                    <Label fx:id="occupiedLabel" text="0" styleClass="stat-number"/>
                </VBox>
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Button text="🚗 Record Entry" onAction="#onRecordEntryClick" styleClass="button-primary"/>
                <Button text="🚙 Record Exit" onAction="#onRecordExitClick"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lastUpdatedLabel" styleClass="message-muted"/>
                <Button text="⟳ Refresh" onAction="#onRefreshClick"/>
            </HBox>

            <TableView fx:id="slotsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="slotNumberColumn" text="Slot"/>
                    <TableColumn fx:id="typeColumn" text="Vehicle Type"/>
                    <TableColumn fx:id="floorColumn" text="Floor"/>
                    <TableColumn fx:id="statusColumn" text="Status"/>
                    <TableColumn fx:id="vehicleColumn" text="Vehicle (Plate No.)"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>