<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ucc.parkingsystem.controller.StaffDashboardController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0"
              style="-fx-padding: 12; -fx-background-color: #1e6b52;">
            <Label text="Staff Dashboard"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="welcomeLabel" style="-fx-text-fill: white;"/>
            <Label fx:id="lastUpdatedLabel" style="-fx-text-fill: gray;"/>
            <Button text="Logout" onAction="#onLogoutClick"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15.0" style="-fx-padding: 15;">

            <!-- The three cards, identical pattern to the Admin dashboard -->
            <HBox spacing="15.0">
                <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #ecf0f1; -fx-padding: 12; -fx-background-radius: 6;">
                    <Label fx:id="totalLabel" text="0"
                           style="-fx-font-size: 30px; -fx-font-weight: bold;"/>
                    <Label text="Total Slots"/>
                </VBox>
                <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #d5f5e3; -fx-padding: 12; -fx-background-radius: 6;">
                    <Label fx:id="availableLabel" text="0"
                           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #1e8449;"/>
                    <Label text="Available"/>
                </VBox>
                <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #fadbd8; -fx-padding: 12; -fx-background-radius: 6;">
                    <Label fx:id="occupiedLabel" text="0"
                           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #c0392b;"/>
                    <Label text="Occupied"/>
                </VBox>
            </HBox>

            <!-- Staff actions: no Manage Staff / Manage Slots here -->
            <HBox spacing="10.0">
                <Button text="Record Entry" onAction="#onRecordEntryClick"/>
                <Button text="Record Exit" onAction="#onRecordExitClick"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Refresh" onAction="#onRefreshClick"/>
            </HBox>

            <!-- Same table pattern as Admin -->
            <TableView fx:id="slotsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="slotNumberColumn" text="Slot"/>
                    <TableColumn fx:id="typeColumn" text="Vehicle Type"/>
                    <TableColumn fx:id="statusColumn" text="Status"/>
                    <TableColumn fx:id="vehicleColumn" text="Vehicle (Plate No.)"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>