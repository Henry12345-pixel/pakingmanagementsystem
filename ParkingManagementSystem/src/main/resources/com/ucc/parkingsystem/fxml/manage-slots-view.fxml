<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ucc.parkingsystem.controller.ManageSlotsController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="header-bar">
            <Button text="← Back" onAction="#onBackClick" styleClass="button-ghost"/>
            <Label text="Manage Parking Slots" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16.0" style="-fx-padding: 24;">

            <!-- Add / Edit form -->
            <!-- Add / Edit form -->
            <VBox spacing="10.0" styleClass="form-panel">
                <Label text="ADD OR EDIT SLOT" styleClass="field-label"/>

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <VBox spacing="4.0">
                        <Label text="Slot Number" styleClass="field-label"/>
                        <TextField fx:id="slotNumberField" promptText="e.g. C-04" prefWidth="120.0"/>
                    </VBox>
                    <VBox spacing="4.0">
                        <Label text="Vehicle Type" styleClass="field-label"/>
                        <ChoiceBox fx:id="typeChoiceBox" prefWidth="180.0"/>
                    </VBox>
                    <VBox spacing="4.0">
                        <Label text="Floor" styleClass="field-label"/>
                        <ChoiceBox fx:id="floorChoiceBox" prefWidth="100.0"/>
                    </VBox>
                </HBox>

                <HBox spacing="8.0">
                    <Button text="Add" onAction="#onAddClick" styleClass="button-primary" minWidth="70.0"/>
                    <Button text="Update Selected" onAction="#onUpdateClick" minWidth="140.0"/>
                    <Button text="Delete Selected" onAction="#onDeleteClick" styleClass="button-danger" minWidth="140.0"/>
                    <Button text="Clear" onAction="#onClearClick" styleClass="button-ghost"
                            style="-fx-text-fill: #64748b;" minWidth="60.0"/>
                </HBox>
            </VBox>
            <Label fx:id="messageLabel" styleClass="message-error"/>

            <!-- Slot list -->
            <TableView fx:id="slotsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="slotNumberColumn" text="Slot"/>
                    <TableColumn fx:id="typeColumn" text="Vehicle Type"/>
                    <TableColumn fx:id="floorColumn" text="Floor"/>
                    <TableColumn fx:id="statusColumn" text="Status"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>